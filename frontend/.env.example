# ==========================================
# BlueCollar AI - Frontend Environment Example
# ==========================================
# Copy to `.env.local` and fill in.
# Everything prefixed NEXT_PUBLIC_ is embedded in the browser bundle, so never
# put a secret here.

# Backend API origin.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public origin of THIS site. Used for canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt. If left at localhost in production, social link
# previews and search indexing will point at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: privacy-friendly analytics. Leave blank to disable entirely —
# no script is loaded and no requests are made when unset.
# Plausible example: NEXT_PUBLIC_PLAUSIBLE_DOMAIN=bluecollarai.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
