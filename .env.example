# ==========================================
# BlueCollar AI — root environment (docker compose)
# ==========================================
# Copy to `.env` in this directory. docker-compose.yml reads it.
#
# For running the two apps directly (npm run dev) use the per-app files instead:
#   backend/.env.example   -> backend/.env
#   frontend/.env.example  -> frontend/.env.local
# Those two are the fully documented references.

# --- Required ---
# The backend refuses to start in production without this. Minimum 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Core ---
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# --- Telephony (Twilio) ---
# TWILIO_AUTH_TOKEN is what authenticates inbound webhooks. Without it they are
# rejected.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Must be the exact PUBLIC https origin Twilio calls (e.g. an ngrok URL).
# Signatures are verified against it, so a wrong value rejects real traffic.
TWILIO_WEBHOOK_BASE_URL=http://localhost:5000

# --- Payments (Stripe) ---
# Without STRIPE_SECRET_KEY, billing runs in simulation mode — no real payment,
# subscription or customer invoice, can be taken.
STRIPE_SECRET_KEY=
# Required whenever STRIPE_SECRET_KEY is set; webhooks are rejected without it.
STRIPE_WEBHOOK_SECRET=
TRIAL_DAYS=14

# --- AI voice engine ---
# mock     = scripted replies, no external calls, no real audio (safe default)
# realtime = Deepgram Nova-2 STT -> LLM tool-calling -> Deepgram Aura TTS
#
# `realtime` needs Deepgram AND one language-model backend. If either is missing
# the provider factory logs a warning and falls back to `mock` rather than
# answering with silence.
VOICE_PROVIDER=mock

# Language model routing. `azure` and `openai` are interchangeable backends.
# LLM_PRIMARY is tried first; LLM_FALLBACK covers the primary being
# unconfigured or failing mid-call. `none` disables failover.
LLM_PRIMARY=azure
LLM_FALLBACK=openai
# Wall-clock budget for one model turn including failover, in ms.
LLM_TOTAL_BUDGET_MS=12000

# Azure OpenAI (primary). All three are required together — a key with no
# endpoint or deployment cannot form a request URL, so the backend is skipped.
AZURE_OPENAI_API_KEY=
# Resource base only, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# The DEPLOYMENT name from Azure AI Foundry, not the model family name.
AZURE_OPENAI_DEPLOYMENT=
# v1 = {endpoint}/openai/v1/chat/completions (recommended, no api-version churn)
# deployment = {endpoint}/openai/deployments/{name}/chat/completions?api-version=
AZURE_OPENAI_API_MODE=v1
# Only read when AZURE_OPENAI_API_MODE=deployment.
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Base URL without the /chat/completions suffix. Change only to route through a
# gateway or proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_TTS_MODEL=aura-asteria-en
MAX_CALL_DURATION_SECONDS=600
# Lifetime of the single-use token that authorizes one Twilio media stream
# WebSocket. Twilio connects right after fetching the TwiML, so this only needs
# to cover that hop.
VOICE_STREAM_TOKEN_TTL_SECONDS=120

# --- Auth session lengths ---
# ACCESS token lifetime. Short on purpose: it cannot be revoked before expiry
# except by bumping the user's token version. Sessions stay alive via the
# refresh token, which the browser rotates transparently.
JWT_EXPIRES_IN=15m
# REFRESH token lifetime in days — how long "stay signed in" lasts.
REFRESH_TOKEN_DAYS=30

# --- Transactional email ---
# Only "resend" is implemented. Password reset and address verification depend
# on this; with no key, those emails fail loudly rather than pretending to send.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Leave false until email works — true without EMAIL_API_KEY is a fatal config
# error, because nobody could ever verify and sign in.
REQUIRE_EMAIL_VERIFICATION=false

# --- Background jobs ---
# Drip follow-ups, review surveys, SLA sweeps, trial expiry, data retention.
# Safe to leave true on every replica: each job takes a lock in MongoDB, so only
# one instance runs a given job at a time.
ENABLE_SCHEDULER=true

# --- Data retention ---
# Days to keep call transcripts and SMS bodies before redacting them. Metrics,
# outcomes and durations are always kept so reporting survives.
# 0 disables the sweep — the default, so a first boot never destroys records.
DATA_RETENTION_DAYS=0

# --- Provider unit prices (cost/margin dashboard) ---
# List prices at time of writing; they drift, hence configurable. Everything
# derived from them is presented as an estimate, not billed spend.
COST_TELEPHONY_PER_MINUTE_USD=0.0085
COST_STT_PER_MINUTE_USD=0.0059
COST_TTS_PER_1K_CHARS_USD=0.015
COST_LLM_INPUT_PER_1M_USD=0.15
COST_LLM_OUTPUT_PER_1M_USD=0.6

# --- Frontend (compiled into the browser bundle at BUILD time) ---
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave blank to load no analytics script at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
