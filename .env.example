# ==========================================
# BlueCollar AI - Root Environment Example
# ==========================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/bluecollar_ai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- Telephony & Communications (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=http://localhost:5000

# --- Payments & Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI & Voice Engine ---
VOICE_PROVIDER=mock
OPENAI_API_KEY=

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:5000
