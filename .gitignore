# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/

# Next.js build output
.next/
out/

# Production build output
dist/
build/
*.tsbuildinfo

# Environment files — never commit real credentials
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*
!frontend/.env.example

# Credential and session artifacts.
# A curl cookie jar can hold a live auth session cookie. Ignored on the filename
# so nobody has to judge whether a given one happens to be populated — that is
# the judgement that gets skipped under time pressure.
cookies.txt
*.cookies
*.pem
*.key
*.p12
*.pfx

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
