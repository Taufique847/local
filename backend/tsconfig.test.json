{
  // Tests are excluded from the build tsconfig so they never land in dist/.
  // This config exists only to typecheck them: `npm run typecheck:tests`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "server.ts", "tests/**/*"]
}
