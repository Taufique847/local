# ==========================================
# BlueCollar AI — Backend Environment
# ==========================================
# Copy to `.env` and fill in. Keys marked REQUIRED IN PRODUCTION are asserted at
# startup by validateConfig() in src/config/env.ts — the server refuses to boot
# without them when NODE_ENV=production.
#
# TO GET THE AI PHONE ASSISTANT WORKING, the minimum set is:
#   1. VOICE_PROVIDER=realtime
#   2. DEEPGRAM_API_KEY                      (speech in AND speech out)
#   3. ONE language-model backend, either:
#        AZURE_OPENAI_API_KEY + _ENDPOINT + _DEPLOYMENT   (all three), or
#        OPENAI_API_KEY
#   4. TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
#   5. TWILIO_WEBHOOK_BASE_URL set to a PUBLIC HTTPS url (ngrok / cloudflared)
# Anything less and calls are answered by the mock provider or not at all.


# ------------------------------------------------------------------
# 1. Server
# ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# REQUIRED IN PRODUCTION. Used for CORS and for customer-portal + email links.
FRONTEND_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=debug


# ------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------
# REQUIRED IN PRODUCTION.
# Note: a standalone mongod cannot run transactions, which is why booking
# concurrency is guarded with a lock collection rather than a session.
MONGODB_URI=mongodb://localhost:27017/bluecollar_ai


# ------------------------------------------------------------------
# 3. Authentication & security
# ------------------------------------------------------------------
# REQUIRED IN PRODUCTION, minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, local development falls back to a well-known insecure value.
JWT_SECRET=

# ACCESS token lifetime — keep it short. It cannot be revoked before it expires
# except by bumping the user's token version, so the window a stolen one is
# useful for should be small. Sessions stay alive via the refresh token below,
# and the browser refreshes transparently.
JWT_EXPIRES_IN=15m

# REFRESH token lifetime in days. This is how long "stay signed in" lasts.
# Refresh tokens are single-use and rotate; presenting an already-rotated one is
# treated as theft and drops every session for that account.
REFRESH_TOKEN_DAYS=30

# Disables Twilio AND Stripe webhook signature verification. LOCAL USE ONLY —
# force-disabled whenever NODE_ENV=production. Leave false unless you are
# replaying a captured webhook by hand.
ALLOW_INSECURE_WEBHOOKS=false


# ------------------------------------------------------------------
# 4. Telephony (Twilio)
# ------------------------------------------------------------------
# https://console.twilio.com — Account SID + Auth Token on the dashboard.
TWILIO_ACCOUNT_SID=
# REQUIRED whenever TWILIO_ACCOUNT_SID is set. Without it inbound webhooks
# cannot be authenticated and every real call is rejected.
TWILIO_AUTH_TOKEN=
# Optional fallback "from" number for SMS. Normally the business's own
# provisioned number is used instead.
TWILIO_PHONE_NUMBER=

# MUST be the public HTTPS base URL Twilio actually calls. Signature validation
# is computed against it, so a wrong value rejects legitimate traffic.
# Locally, start a tunnel and paste its https URL here:
#   ngrok http 5000          -> https://<something>.ngrok-free.app
#   cloudflared tunnel --url http://localhost:5000
# Leaving this at localhost also blocks the owner test-call feature, which
# refuses to dial when Twilio could not reach this server.
TWILIO_WEBHOOK_BASE_URL=http://localhost:5000


# ------------------------------------------------------------------
# 5. AI voice engine
# ------------------------------------------------------------------
# mock     = deterministic scripted replies, no external calls, no real audio.
#            Safe default for local development.
# realtime = the production pipeline: Deepgram streaming STT -> OpenAI
#            tool-calling -> Deepgram Aura TTS, bridged to Twilio Media Streams
#            as 8 kHz mu-law.
#
# `realtime` needs Deepgram AND a language-model backend below. If either is
# missing the factory logs a warning and downgrades to `mock` rather than
# answering calls with silence.
VOICE_PROVIDER=mock

# --- Language model routing ---------------------------------------
# Two interchangeable backends: `azure` (Azure OpenAI) and `openai` (public
# OpenAI). They share the same request/response schema, so switching is purely
# configuration.
#
# LLM_PRIMARY  is tried first.
# LLM_FALLBACK is used when the primary is not fully configured, OR when a live
#              request to it fails after its retries. Set to `none` to disable
#              failover and fail the turn instead.
#
# A backend that is not fully configured is skipped, not attempted — so if
# LLM_PRIMARY=azure but the Azure values are blank, every call quietly goes to
# OpenAI. Check GET /api/health/deep -> integrations.llm.active to see which
# backend will really serve the next call.
LLM_PRIMARY=azure
LLM_FALLBACK=openai

# Total wall-clock budget for one model turn, including failover, in ms. A
# caller is on the line, so once this is spent the turn is abandoned rather than
# starting another request against the second backend.
LLM_TOTAL_BUDGET_MS=12000

# --- Azure OpenAI (primary) ---------------------------------------
# Portal -> your Azure OpenAI resource -> Keys and Endpoint.
# All THREE of KEY + ENDPOINT + DEPLOYMENT are required; a key alone is not
# enough to build a request URL, so a partial set disables the Azure backend.
AZURE_OPENAI_API_KEY=
# Resource base only, no path. e.g. https://my-resource.openai.azure.com
# A trailing slash or an accidentally pasted /openai/v1 suffix is trimmed.
AZURE_OPENAI_ENDPOINT=
# Your DEPLOYMENT name (what you named it in Azure AI Foundry), not the model
# family name. These are often the same but do not have to be.
AZURE_OPENAI_DEPLOYMENT=
# v1         = POST {endpoint}/openai/v1/chat/completions
#              Recommended. No api-version to keep bumping every month.
# deployment = POST {endpoint}/openai/deployments/{deployment}/chat/completions
#              ?api-version=AZURE_OPENAI_API_VERSION
#              Use this if your resource does not serve the v1 route yet.
AZURE_OPENAI_API_MODE=v1
# Only read when AZURE_OPENAI_API_MODE=deployment.
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI (fallback) --------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible base URL, WITHOUT the /chat/completions suffix. Change only
# to route through a gateway or proxy (Azure API Management, LiteLLM, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1

# Speech recognition and speech synthesis. https://console.deepgram.com
DEEPGRAM_API_KEY=
# nova-2-phonecall is tuned for 8 kHz telephony audio.
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_TTS_MODEL=aura-asteria-en

# Hard ceiling on a single AI call, in seconds. Stops a stuck call billing
# indefinitely.
MAX_CALL_DURATION_SECONDS=600

# Lifetime of the single-use token that authorizes one Twilio media stream.
# Twilio opens the WebSocket immediately after fetching the TwiML, so this only
# has to cover that one hop — short is the point. Raise it only if you see
# `stream_upgrade_rejected` with reason `expired` in the logs.
VOICE_STREAM_TOKEN_TTL_SECONDS=120


# ------------------------------------------------------------------
# 6. Payments & billing (Stripe)
# ------------------------------------------------------------------
# Without STRIPE_SECRET_KEY billing runs in simulation mode: no subscription and
# no customer invoice payment can actually be taken.
STRIPE_SECRET_KEY=
# REQUIRED whenever STRIPE_SECRET_KEY is set. Webhooks are rejected without it,
# which means paid invoices would never be marked paid.
STRIPE_WEBHOOK_SECRET=

# Optional: use Prices created in the Stripe dashboard instead of inline
# price_data, so pricing can change without a deploy.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# Length of the free trial granted to a new business.
TRIAL_DAYS=14


# ------------------------------------------------------------------
# 7. Transactional email
# ------------------------------------------------------------------
# Only "resend" is implemented. Any other value raises an error rather than
# being silently ignored.
EMAIL_PROVIDER=resend
# https://resend.com/api-keys
EMAIL_API_KEY=
# Must be an address on a domain verified with the provider.
EMAIL_FROM_ADDRESS=

# When true, an unverified account cannot log in.
# Leave false until email actually works — turning it on without EMAIL_API_KEY
# is a fatal config error precisely because nobody could ever verify and sign in.
REQUIRE_EMAIL_VERIFICATION=false


# ------------------------------------------------------------------
# 8. Background jobs
# ------------------------------------------------------------------
# Runs the in-process scheduler: speed-to-lead drips, post-service review
# surveys, negative-review SLA sweeps, trial expiry, and data retention.
# Safe to leave true on every replica — each job takes a lock in MongoDB so only
# one instance runs it at a time.
ENABLE_SCHEDULER=true


# ------------------------------------------------------------------
# 9. Data retention
# ------------------------------------------------------------------
# Days to keep call transcripts and SMS bodies before redacting them. Call
# metrics, outcomes and durations are always kept, so reporting survives.
# 0 disables the sweep entirely — the default, because switching retention on
# automatically would start destroying existing records on first boot.
DATA_RETENTION_DAYS=0


# ------------------------------------------------------------------
# 10. Provider unit prices (for the cost/margin dashboard)
# ------------------------------------------------------------------
# Used to turn recorded per-call usage into money. These are list prices at the
# time of writing and WILL drift, so they are configurable. Everything derived
# from them is labelled an estimate, not billed spend.
COST_TELEPHONY_PER_MINUTE_USD=0.0085
COST_STT_PER_MINUTE_USD=0.0059
COST_TTS_PER_1K_CHARS_USD=0.015
COST_LLM_INPUT_PER_1M_USD=0.15
COST_LLM_OUTPUT_PER_1M_USD=0.6
