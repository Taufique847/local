# ==========================================
# BlueCollar AI - Backend Environment Example
# ==========================================

# --- 1. Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- 2. Database ---
MONGODB_URI=mongodb://localhost:27017/bluecollar_ai

# --- 3. Authentication & Security ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- 4. Telephony & Communications (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=http://localhost:5000

# --- 5. Payments & Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 6. AI & Voice Streaming Engine ---
VOICE_PROVIDER=mock
OPENAI_API_KEY=
